{
  "name": "bluecadet/bc_composer_ci_tools",
  "description": "Adds functionality for ci and composer tools built by Bluecadet.",
  "authors": [
    {
      "name": "Pete Inge",
      "email": "pete.inge@gmail.com",
      "role": "Maintainer"
    }
  ],
  "support": {
    "issues": "https://github.com/bluecadet/bc_composer_ci_tools/issues"
  },
  "license": "GPL-2.0+",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.0",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "Bluecadet\\": "src/"
    }
  },
  "scripts": {
      "run-phpcs": "Bluecadet\\PhpCsChecksCommand"
  },
  "bin": [
    "bin/bc-run-drupal-check",
    "bin/bc-run-js-lint",
    "bin/bc-run-phpcs",
    "bin/bc-run-phpstan"
  ],
  "config": {
    "sort-packages": true
  }
}
